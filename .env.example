# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_USER_ID=6193695760

# Comet API Settings
COMETAPI_KEY=your_cometapi_key_here
COMETAPI_BASE_URL=https://api.cometapi.com

# Models
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gpt-6-luna

# Database (SQLite by default, easily swapped to postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///poxydator.db

# Web search (used only when the model is unsure about a dish)
ENABLE_WEB_SEARCH=true

# Payment Feature Flags
ENABLE_TELEGRAM_STARS=false
ENABLE_CARD_PAYMENTS=false

# Optional Provider Token for Card Payments (from BotFather: YooKassa / Stripe)
PAYMENT_PROVIDER_TOKEN=

# Time & Scheduler
DEFAULT_TIMEZONE=Europe/Moscow
EVENING_SUMMARY_HOUR=22
EVENING_SUMMARY_MINUTE=0
